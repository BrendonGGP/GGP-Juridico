{
  "mcpServers": {
    "approved-filesystem-readonly": {
      "command": "docker",
      "args": [
        "run",
        "--rm",
        "-i",
        "--network",
        "none",
        "--read-only",
        "--cap-drop",
        "ALL",
        "--security-opt",
        "no-new-privileges",
        "--memory",
        "256m",
        "--cpus",
        "0.5",
        "--pids-limit",
        "64",
        "-v",
        "{{APPROVED_READONLY_PATH}}:/workspace:ro",
        "{{PINNED_MCP_IMAGE_WITH_DIGEST}}"
      ],
      "env": {}
    }
  }
}
