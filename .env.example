# GGP-Jurídico — variáveis de ambiente
# Copie para .env e preencha. NUNCA versione o .env nem cole valores reais aqui.

# --- Ambiente ---
NODE_ENV=development
APP_ENV=development                  # development | staging | production

# --- Banco de dados ---
# Verifique o ambiente antes de qualquer escrita: nunca presuma que é banco de teste.
DATABASE_URL=

# --- Autenticação ---
AUTH_SECRET=                         # gerar com: openssl rand -base64 32
AUTH_URL=http://localhost:3000

# --- Supabase (auth + storage) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=           # somente no servidor. Nunca expor ao cliente.

# --- Superfície de LLM (§3.3 Sumário Executivo) ---
# Entra DESLIGADA. Ligar só depois do fallback determinístico validado.
LLM_SUMARIO_HABILITADO=false
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_GUARD_MODEL=claude-haiku-4-5-20251001   # verificador factual

# --- Limites de ingestão (ver seguranca/configuracao-projeto.yaml) ---
MAX_UPLOAD_MB=25
MAX_LINHAS_PLANILHA=5000
TIMEOUT_INGESTAO_SEGUNDOS=300

# --- Auditoria ---
AUDIT_LOG_HABILITADO=true
LOG_LEVEL=info                       # logs nunca contêm PII ou valor por processo
